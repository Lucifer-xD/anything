<resources>

    <!-- Force dark theme everywhere — fixes Settings, dialogs, About automatically -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="colorPrimary">#00B4FF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#00B4FF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#111111</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#1A1A1A</item>
        <item name="colorOnSurfaceVariant">#AAAAAA</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorAccent">#00B4FF</item>
        <item name="android:colorAccent">#00B4FF</item>
        <item name="android:dialogTheme">@style/NexAlertDialog</item>
        <item name="android:alertDialogTheme">@style/NexAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/NexAlertDialog</item>
        <!-- Smooth window animations -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>

    <style name="WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="AppTheme.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="SplashTheme.Fullscreen" parent="SplashTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="NexAlertDialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">#00B4FF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:colorAccent">#00B4FF</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton.Negative</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Dialog.Rounded</item>
    </style>

    <!-- Keep old name as alias so existing references don't break -->
    <style name="DarkAlertDialog" parent="NexAlertDialog" />

    <style name="DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="android:textColor">#000000</item>
        <item name="backgroundTint">#00B4FF</item>
    </style>

    <style name="DialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#00B4FF</item>
    </style>

    <style name="DialogWindowTitle" parent="android:Widget.TextView">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SafetyDialogTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="ThemeOverlay.ExtremeDark" parent="">
        <item name="colorSurface">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="ThemeOverlay.GradientBackground" parent="">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
    </style>

    <!-- Segmented Button Shapes -->
    <style name="ShapeAppearance.App.Button.Left" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Middle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Button.Right" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

</resources>
