<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Connection Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/status_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:gravity="center_vertical">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_status_dot"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_waiting"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_waiting_subtitle"
                    android:textColor="@color/text_second"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_badge_ready"
                android:textColor="@color/status_disconnected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main 2x2 Button Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_buttons_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/status_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Android Auto + USB -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/self_mode_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="8dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/usb_button"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:layout_margin="20dp"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_blue"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_launch_white"
            app:iconTint="#ffffff"
            app:iconSize="64dp"
            app:iconPadding="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />
        <TextView
            android:id="@+id/self_mode_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/self_mode_button"
            app:layout_constraintStart_toStartOf="@+id/self_mode_button"
            app:layout_constraintEnd_toEndOf="@+id/self_mode_button"
            android:text="@string/self_mode"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/usb_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="8dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/self_mode_button"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="20dp"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_orange"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_usb_white"
            app:iconTint="#ffffff"
            app:iconSize="64dp"
            app:iconPadding="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />
        <TextView
            android:id="@+id/usb_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/usb_button"
            app:layout_constraintStart_toStartOf="@+id/usb_button"
            app:layout_constraintEnd_toEndOf="@+id/usb_button"
            android:text="@string/usb"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/row1_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="self_mode_text,usb_text" />

        <!-- Row 2: WiFi + Settings -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wifi_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="8dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@+id/row1_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/settings_button"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:layout_margin="20dp"
            android:layout_marginTop="32dp"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_purple"
            app:iconGravity="textStart"
            app:icon="@drawable/ic_network_wifi_white"
            app:iconTint="#ffffff"
            app:iconSize="64dp"
            app:iconPadding="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />
        <TextView
            android:id="@+id/wifi_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/wifi_button"
            app:layout_constraintStart_toStartOf="@+id/wifi_button"
            app:layout_constraintEnd_toEndOf="@+id/wifi_button"
            android:text="@string/wifi"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="8dp"
            app:iconGravity="textStart"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@+id/row1_barrier"
            app:layout_constraintStart_toEndOf="@+id/wifi_button"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="20dp"
            android:layout_marginTop="32dp"
            app:backgroundTint="@null"
            android:background="@drawable/gradient_darkblue"
            app:icon="@drawable/ic_settings_white"
            app:iconTint="#ffffff"
            app:iconSize="64dp"
            app:iconPadding="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />
        <TextView
            android:id="@+id/settings_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/settings_button"
            app:layout_constraintStart_toStartOf="@+id/settings_button"
            app:layout_constraintEnd_toEndOf="@+id/settings_button"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="4dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Exit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:text="@string/exit"
        app:backgroundTint="#33FFFFFF"
        android:textColor="@color/text_second"
        app:cornerRadius="24dp"
        android:textSize="13sp" />

</androidx.constraintlayout.widget.ConstraintLayout>
