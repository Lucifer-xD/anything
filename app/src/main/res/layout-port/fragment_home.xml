<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- App name -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NexDrive"
        android:textColor="@color/nex_blue"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status -->
    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_status_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_waiting"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_badge_ready"
            android:textColor="@color/status_disconnected"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#00B4FF"
        android:alpha="0.3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Large AA button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/self_mode_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintBottom_toTopOf="@+id/usb_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_primary"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_launch_white"
        app:iconTint="#FFFFFF"
        app:iconSize="48dp"
        app:iconPadding="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp" />

    <TextView
        android:id="@+id/self_mode_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/self_mode"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/usb_button"
        app:layout_constraintStart_toStartOf="@+id/self_mode_button"
        app:layout_constraintEnd_toEndOf="@+id/self_mode_button" />

    <!-- USB -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/usb_button"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toTopOf="@+id/wifi_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_secondary"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_usb_white"
        app:iconTint="@color/nex_blue"
        app:iconSize="28dp"
        app:iconPadding="0dp" />
    <TextView
        android:id="@+id/usb_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/usb"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/wifi_button"
        app:layout_constraintStart_toStartOf="@+id/usb_button"
        app:layout_constraintEnd_toEndOf="@+id/usb_button" />

    <!-- WiFi -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/wifi_button"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toTopOf="@+id/settings_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_secondary"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_network_wifi_white"
        app:iconTint="@color/nex_blue"
        app:iconSize="28dp"
        app:iconPadding="0dp" />
    <TextView
        android:id="@+id/wifi_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wifi"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/settings_button"
        app:layout_constraintStart_toStartOf="@+id/wifi_button"
        app:layout_constraintEnd_toEndOf="@+id/wifi_button" />

    <!-- Settings -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_button"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toTopOf="@+id/exit_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/btn_secondary"
        app:iconGravity="textStart"
        app:icon="@drawable/ic_settings_white"
        app:iconTint="@color/nex_blue"
        app:iconSize="28dp"
        app:iconPadding="0dp" />
    <TextView
        android:id="@+id/settings_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/exit_button"
        app:layout_constraintStart_toStartOf="@+id/settings_button"
        app:layout_constraintEnd_toEndOf="@+id/settings_button" />

    <!-- Exit -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:text="@string/exit"
        app:backgroundTint="#00000000"
        android:textColor="#444444"
        app:strokeColor="#222222"
        app:strokeWidth="1dp"
        app:cornerRadius="20dp"
        android:textSize="12sp" />

</androidx.constraintlayout.widget.ConstraintLayout>
