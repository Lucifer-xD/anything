<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Nimbus</string>
    <key>CFBundleName</key>
    <string>NimbusVPN</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Permission usage strings (Phase: Permissions screen) -->
    <key>NSFaceIDUsageDescription</key>
    <string>Nimbus uses Face ID to unlock your saved configurations and lock the app.</string>
    <key>NSCameraUsageDescription</key>
    <string>Nimbus uses the camera to scan configuration QR codes.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Nimbus measures latency and health of your tunnel servers on the local network.</string>

    <!-- Deep-link + share import: nimbus:// and common config schemes -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>net.nimbus.vpn.import</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nimbus</string>
                <string>vmess</string>
                <string>vless</string>
                <string>trojan</string>
                <string>ss</string>
                <string>hysteria2</string>
                <string>hy2</string>
                <string>tuic</string>
            </array>
        </dict>
    </array>

    <!-- Files app / iCloud Drive import of config documents -->
    <key>UISupportsDocumentBrowser</key>
    <false/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Tunnel Configuration</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.nimbus.config</string>
                <string>public.json</string>
                <string>public.text</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>net.nimbus.config</string>
            <key>UTTypeDescription</key>
            <string>Nimbus Configuration Bundle</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>nimbus</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
